# Copy to .env and fill in synthetic local credentials.
# These application variables are for docker run --env-file; Compose derives its SQL connection below.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
# SQL example: Server=host.docker.internal,14333;Database=ICS2026_LocalTest;User Id=sa;Password=YOUR_LOCAL_PASSWORD;Encrypt=True;TrustServerCertificate=True
ConnectionStrings__DefaultConnection=
# Use a private random key with at least 32 UTF-8 bytes.
Jwt__Key=
Jwt__Issuer=Dsw2025Tpi.Api
Jwt__Audience=Dsw2025Tpi.Api.Users
Jwt__ExpireInMinutes=60

# Docker Compose: DB_PASSWORD and JWT_KEY are required and have no default secrets.
DB_PASSWORD=
JWT_KEY=
SQL_PORT=14333
API_PORT=5142
JWT_ISSUER=Dsw2025Tpi.Api
JWT_AUDIENCE=Dsw2025Tpi.Api.Users
JWT_EXPIRE_IN_MINUTES=60
# Optional administrator, created only by the migration service.
SEED_ADMIN_ENABLED=false
SEED_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
